<Window x:Class="Plicbox.App.AccountSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Title="{local:T 'Add account'}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <!-- Content scrolls when the server settings make it taller than the screen; the buttons stay in view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,0">
        <TextBlock Text="{local:T 'Add an email account'}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Subtitle" Text="{local:T 'Enter your address and Plicbox works out the rest.'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />

        <!-- Step 1: one click for Google, or type an address for anything else -->
        <StackPanel x:Name="StepIdentity">
            <Button x:Name="GoogleQuickButton" Click="GoogleQuick_Click" Margin="0,10,0,0" Padding="14,10" Cursor="Hand"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Google's own "G" (the paths of its sign-in button artwork) -->
                    <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Canvas Width="48" Height="48">
                            <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                            <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                            <Path Fill="#FBBC05" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                            <Path Fill="#34A853" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{local:T 'Sign in with Google'}" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="GoogleHint" Style="{StaticResource Hint}" Text="{local:T 'Gmail and Google Workspace (including your own domain)'}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <Button x:Name="MicrosoftQuickButton" Click="MicrosoftQuick_Click" Margin="0,12,0,0" Padding="14,10" Cursor="Hand"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Microsoft's four squares -->
                    <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Canvas Width="23" Height="23">
                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" Fill="#F25022" />
                            <Rectangle Canvas.Left="12" Canvas.Top="1" Width="10" Height="10" Fill="#7FBA00" />
                            <Rectangle Canvas.Left="1" Canvas.Top="12" Width="10" Height="10" Fill="#00A4EF" />
                            <Rectangle Canvas.Left="12" Canvas.Top="12" Width="10" Height="10" Fill="#FFB900" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{local:T 'Sign in with Microsoft'}" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="MicrosoftHint" Style="{StaticResource Hint}" Text="{local:T 'Outlook.com, Hotmail and Microsoft 365'}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <Grid x:Name="ProviderDivider" Margin="0,18,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{local:T 'or another provider'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="10,0" />
                <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Your name (shown to people you email)'}" />
            <TextBox x:Name="NameBox" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Email address'}" />
            <TextBox x:Name="EmailBox" />
        </StackPanel>

        <!-- Step 2a: Google (Gmail / Workspace) -->
        <StackPanel x:Name="StepGoogle" Visibility="Collapsed" Margin="0,14,0,0">
            <Border Background="{DynamicResource InfoFillBrush}" BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <TextBlock x:Name="GoogleIntro" TextWrapping="Wrap"
                           Text="{local:T 'This address uses Google. Plicbox opens your browser so you sign in with Google directly. Your password never passes through Plicbox.'}" />
            </Border>

            <StackPanel x:Name="GoogleSetup" Margin="0,14,0,0">
                <TextBlock Text="{local:T 'One-time setup (about 5 minutes)'}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                           Text="{local:T 'Plicbox signs in through your own Google Cloud project, so it doesn\'t depend on anyone else\'s servers. You do this once; every Google account then uses it.'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '1.  In Google Cloud Console, create a project (e.g. &quot;Plicbox&quot;).'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '2.  APIs &amp; Services → Library → Gmail API → Enable.'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '3.  Google Auth Platform → Branding: app name &quot;Plicbox&quot;, your email. Audience: External, then Publish app (In production).'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '4.  Data Access → Add scope: https://mail.google.com/'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '5.  Clients → Create client → Desktop app → Download JSON.'}" />
                <TextBlock Style="{StaticResource Step}" Text="{local:T '6.  Choose that file below.'}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{local:T 'Open Google Cloud Console'}" Padding="12,5" Click="OpenConsole_Click" />
                    <Button Content="{local:T 'Choose client file…'}" Padding="12,5" Margin="8,0,0,0" Click="ChooseClientFile_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="{local:T 'Google may warn that it hasn\'t verified Plicbox yet: choose Advanced → Go to Plicbox.'}" />
            <TextBlock Margin="0,10,0,0" FontSize="13">
                <Hyperlink Click="UseAppPassword_Click" Style="{StaticResource QuietLink}"><Run Text="{local:T 'Use an app password instead'}" /></Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Step 2c: Microsoft (Outlook.com, Hotmail, Microsoft 365) -->
        <StackPanel x:Name="StepMicrosoft" Visibility="Collapsed" Margin="0,14,0,0">
            <Border Background="{DynamicResource InfoFillBrush}" BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <TextBlock x:Name="MicrosoftIntro" TextWrapping="Wrap" />
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="{local:T 'Work or school account? Your organization may have to approve Plicbox before you can sign in.'}" />
        </StackPanel>

        <!-- Step 2b: password + server settings -->
        <StackPanel x:Name="StepPassword" Visibility="Collapsed">
            <!-- What the provider wants done first (an app password, IMAP switched on), and where -->
            <Border x:Name="ProviderHelpBox" Visibility="Collapsed" Margin="0,14,0,2" Background="{DynamicResource InfoFillBrush}"
                    BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="ProviderHelpText" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock x:Name="ProviderHelpLinkRow" Margin="0,6,0,0" FontSize="13">
                        <Hyperlink Click="ProviderHelpLink_Click" Style="{StaticResource QuietLink}"><Run x:Name="ProviderHelpLink" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Password'}" />
            <PasswordBox x:Name="PasswordBox" />
            <Expander x:Name="ServerExpander" Header="{local:T 'Server settings'}" Margin="0,14,0,0">
                <StackPanel Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Incoming (IMAP) server'}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{local:T 'Port'}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="{local:T 'Encryption'}" />
                        <TextBox x:Name="ImapHostBox" Grid.Row="1" TextChanged="ImapHost_Changed" />
                        <TextBox x:Name="ImapPortBox" Grid.Row="1" Grid.Column="2" Text="993" />
                        <ComboBox x:Name="ImapSecurityBox" Grid.Row="1" Grid.Column="4" SelectedIndex="0" SelectionChanged="Security_Changed">
                            <ComboBoxItem Content="{local:T 'Automatic'}" />
                            <ComboBoxItem Content="{local:T 'SSL/TLS'}" />
                            <ComboBoxItem Content="{local:T 'STARTTLS'}" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{local:T 'Outgoing (SMTP) server'}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{local:T 'Port'}" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldLabel}" Text="{local:T 'Encryption'}" />
                        <TextBox x:Name="SmtpHostBox" Grid.Row="3" />
                        <TextBox x:Name="SmtpPortBox" Grid.Row="3" Grid.Column="2" Text="465" />
                        <ComboBox x:Name="SmtpSecurityBox" Grid.Row="3" Grid.Column="4" SelectedIndex="0" SelectionChanged="Security_Changed">
                            <ComboBoxItem Content="{local:T 'Automatic'}" />
                            <ComboBoxItem Content="{local:T 'SSL/TLS'}" />
                            <ComboBoxItem Content="{local:T 'STARTTLS'}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'User name'}" />
                    <TextBox x:Name="UsernameBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Outgoing sign-in'}" />
                    <ComboBox x:Name="SmtpAuthBox" SelectedIndex="0" SelectionChanged="SmtpAuth_Changed">
                        <ComboBoxItem Content="{local:T 'Same as incoming'}" />
                        <ComboBoxItem Content="{local:T 'Its own user name and password'}" />
                        <ComboBoxItem Content="{local:T 'No sign-in (the server doesn\'t ask for one)'}" />
                    </ComboBox>
                    <Grid x:Name="SmtpLoginPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Outgoing user name'}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{local:T 'Outgoing password'}" />
                        <TextBox x:Name="SmtpUserBox" Grid.Row="1" />
                        <PasswordBox x:Name="SmtpPasswordBox" Grid.Row="1" Grid.Column="2" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{local:T 'Automatic uses SSL/TLS on ports 993 and 465 and STARTTLS on any other port. Unencrypted connections are never used.'}" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Step 3: done (added, or an existing account signed in again) -->
        <Border x:Name="StepDone" Visibility="Collapsed" Margin="0,14,0,0" Background="{DynamicResource InfoFillBrush}"
                BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
            <TextBlock x:Name="DoneText" TextWrapping="Wrap" />
        </Border>

    </StackPanel>
    </ScrollViewer>

        <!-- Always in view: what went wrong (and a fix, if we have one), progress, the buttons -->
        <StackPanel Grid.Row="1" Margin="32,0,32,24">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
            <!-- A fix we can make for you (the certificate's real server name) -->
            <Button x:Name="FixButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" Click="Fix_Click" />

            <StackPanel x:Name="Busy" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Spinner}" />
                <TextBlock x:Name="BusyText" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{local:T 'Cancel'}" IsCancel="True" MinWidth="90" Padding="12,6" />
                <Button x:Name="AnotherButton" Content="{local:T 'Add another account'}" Visibility="Collapsed" MinWidth="90" Padding="12,6"
                        Click="Another_Click" />
                <Button x:Name="PrimaryButton" Content="{local:T 'Continue'}" IsDefault="True" MinWidth="110" Padding="14,6" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Primary_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
