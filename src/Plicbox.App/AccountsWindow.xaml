<Window x:Class="Plicbox.App.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plicbox.App.ViewModels"
        xmlns:local="clr-namespace:Plicbox.App"
        Title="{local:T 'Accounts'}" Width="1060" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <local:InverseBoolConverter x:Key="InverseBool" />
        <Style x:Key="FormBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndCloseCommand}" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <TextBlock Text="{local:T 'Save &amp; Close'}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE710;" Content="{local:T 'Add account'}" Command="{Binding AddCommand}" Margin="14,0,0,0" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE734;" Content="{local:T 'Set as default'}" Command="{Binding SetDefaultCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Remove'}" Command="{Binding RemoveCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE70E;" Command="{Binding MoveUpCommand}" ToolTip="{local:T 'Move up'}" Margin="10,0,0,0" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE70D;" Command="{Binding MoveDownCommand}" ToolTip="{local:T 'Move down'}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource DangerTextBrush}" Margin="18,8,18,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Account list -->
            <ListBox ItemsSource="{Binding Editors}" SelectedItem="{Binding Selected}" BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource ChromeBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="14,10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AccountEditor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="{Binding AvatarBrush}" />
                                <local:CenteredInitial Text="{Binding Initial}" Scale="0.425" />
                                <Ellipse x:Name="AccountPicture" Stroke="{DynamicResource AvatarRingBrush}" StrokeThickness="0.5" Margin="-0.75">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border x:Name="DefaultStar" Width="17" Height="17" CornerRadius="9" Background="{DynamicResource LinkBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" Visibility="Collapsed" ToolTip="{local:T 'Default account'}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="9" Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Email}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Picture}" Value="{x:Null}">
                                <Setter TargetName="AccountPicture" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="DefaultStar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Settings for the selected account -->
            <TabControl x:Name="Tabs" Grid.Column="1" DataContext="{Binding Selected}" Style="{StaticResource SegmentedTabs}"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabItem Header="{local:T 'General'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Style="{StaticResource PagePanel}">
                            <!-- The sign-in was turned down: the fix sits on top, not only under IMAP -->
                            <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource WarningFillBrush}" BorderBrush="{DynamicResource WarningStrokeBrush}" BorderThickness="1"
                                    Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="13" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="{local:T 'Sign in again…'}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"
                                            Command="{Binding DataContext.SignInAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Account name:'}" />
                                <TextBox Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{local:T 'Shown in the sidebar. Leave empty to show the address.'}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{local:T 'Name:'}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{local:T 'Shown to people you email.'}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{local:T 'Email:'}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding Email, Mode=OneWay}" IsReadOnly="True"
                                         Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{local:T 'Picture:'}" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <Grid Width="40" Height="40">
                                        <Ellipse Fill="{Binding AvatarBrush}" />
                                        <local:CenteredInitial Text="{Binding Initial}" Scale="0.425" />
                                        <Ellipse Stroke="{DynamicResource AvatarRingBrush}" StrokeThickness="0.5" Margin="-0.75"
                                                 Visibility="{Binding Picture, Converter={StaticResource NullToCollapsed}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <Button Content="{local:T 'Choose…'}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ChoosePictureCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Content="{local:T 'Remove'}" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemovePictureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding Picture, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{local:T 'Shown on mail you send. Without one, the coloured letter is used.'}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Aliases (send as)'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <DataGrid ItemsSource="{Binding Aliases}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" MinHeight="70" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:T 'Name'}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn Header="{local:T 'Address'}" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <!-- Cells pad 10 px each side, so the column must fit 20 px plus the button (6+17+6). -->
                                    <DataGridTemplateColumn Width="52" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="6,2" ToolTip="{local:T 'Remove alias'}"
                                                        Command="{Binding DataContext.RemoveAliasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{local:T 'Add alias'}" Padding="12,4" Command="{Binding AddAliasCommand}" />
                                <Button Content="{local:T 'Import from Gmail'}" Padding="12,4" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ImportGmailAliasesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding IsGoogle, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{local:T 'Pick these in the From field when writing. Replies automatically use the alias the message was sent to. Gmail only sends from addresses set up under Gmail → Settings → Accounts → Send mail as.'}" />

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Signature'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <TextBox Text="{Binding Signature, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="100" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"
                                       Text="{local:T 'Added to new messages, replies and forwards. Plain text, or HTML if you paste markup.'}" />

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Copies'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Bcc address:'}" />
                                <TextBox Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding BccAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{local:T 'Every message you send from this account is also sent, hidden, to this address.'}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{local:T 'IMAP'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Style="{StaticResource PagePanel}">
                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Server'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Host:'}" />
                                <TextBox Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{local:T 'Port:'}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{local:T 'Security policy:'}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5" SelectedIndex="{Binding ImapSecurityIndex}">
                                    <ComboBoxItem Content="{local:T 'Automatic (TLS on 993, STARTTLS otherwise)'}" />
                                    <ComboBoxItem Content="{local:T 'Use TLS on special port'}" />
                                    <ComboBoxItem Content="{local:T 'Use STARTTLS (always)'}" />
                                </ComboBox>
                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{local:T 'User name:'}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="{local:T 'Sign-in:'}" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Text="{Binding SignInMethod}" VerticalAlignment="Center" />
                                    <Button Content="{local:T 'Sign in again…'}" Margin="16,0,0,0" Padding="12,4"
                                            Command="{Binding DataContext.SignInAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Sync options'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Sync period:'}" />
                                <ComboBox Grid.Column="1" Margin="0,5" SelectedIndex="{Binding SyncPeriodIndex}">
                                    <ComboBoxItem Content="{local:T 'All time'}" />
                                    <ComboBoxItem Content="{local:T 'Last month'}" />
                                    <ComboBoxItem Content="{local:T 'Last 3 months'}" />
                                    <ComboBoxItem Content="{local:T 'Last 6 months'}" />
                                    <ComboBoxItem Content="{local:T 'Last year'}" />
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Offline mail:'}" />
                                <ComboBox Grid.Column="1" Margin="0,5" SelectedIndex="{Binding OfflineIndex}">
                                    <ComboBoxItem Content="{local:T 'Download when opened'}" />
                                    <ComboBoxItem Content="{local:T 'Keep the last month'}" />
                                    <ComboBoxItem Content="{local:T 'Keep the last 6 months'}" />
                                    <ComboBoxItem Content="{local:T 'Keep the last year'}" />
                                    <ComboBoxItem Content="{local:T 'Keep everything synced'}" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="150,4,0,0" TextWrapping="Wrap"
                                       Text="{local:T 'Messages kept on this computer open instantly, also offline, and search covers their text. Others download when you first open them. Mail older than the sync period stays on the server only.'}" />

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Special folders'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <CheckBox x:Name="AutoDetect" Content="{local:T 'Automatically detect special folder names'}" IsChecked="{Binding AutoDetectFolders}" Margin="150,0,0,8" />
                            <Grid IsEnabled="{Binding IsChecked, ElementName=AutoDetect, Converter={StaticResource InverseBool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Sent:'}" />
                                <ComboBox Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding SentPath}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{local:T 'Drafts:'}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding DraftsPath}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{local:T 'Trash:'}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding TrashPath}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{local:T 'Junk:'}" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding JunkPath}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="{local:T 'Archive:'}" />
                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding ArchivePath}" />
                            </Grid>

                            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Ignored paths'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                            <TextBlock Text="{local:T 'Don\'t show or sync these folders (and their subfolders):'}" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding IgnoredPaths}" Style="{StaticResource EntryList}" MinHeight="60" MaxHeight="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="6,2" ToolTip="{local:T 'Remove'}"
                                                    Command="{Binding DataContext.RemoveIgnoredPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{local:T 'Add'}" Padding="14,4" Margin="8,0,0,0" Command="{Binding AddIgnoredPathCommand}" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding FolderPaths}" Text="{Binding NewIgnoredPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{local:T 'SMTP'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PagePanel}">
                        <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Server'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Host:'}" />
                            <TextBox Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{local:T 'Port:'}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{local:T 'Security policy:'}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5" SelectedIndex="{Binding SmtpSecurityIndex}">
                                <ComboBoxItem Content="{local:T 'Automatic (TLS on 465, STARTTLS otherwise)'}" />
                                <ComboBoxItem Content="{local:T 'Use TLS on special port'}" />
                                <ComboBoxItem Content="{local:T 'Use STARTTLS (always)'}" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Sign-in'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                        <Grid IsEnabled="{Binding IsGoogle, Converter={StaticResource InverseBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="{local:T 'Sign in with:'}" />
                            <ComboBox Grid.Column="1" Margin="0,5" SelectedIndex="{Binding SmtpAuthIndex}">
                                <ComboBoxItem Content="{local:T 'Same as incoming mail'}" />
                                <ComboBoxItem Content="{local:T 'Its own user name and password'}" />
                                <ComboBoxItem Content="{local:T 'No sign-in (the server doesn\'t ask for one)'}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{local:T 'User name:'}"
                                       Visibility="{Binding HasSmtpLogin, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding HasSmtpLogin, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{local:T 'Password:'}"
                                       Visibility="{Binding HasSmtpLogin, Converter={StaticResource BoolToVisibility}}" />
                            <PasswordBox x:Name="SmtpPasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,5" PasswordChanged="SmtpPassword_Changed"
                                         local:Placeholder.Text="{Binding SmtpPasswordHint}"
                                         ToolTip="{local:T 'Leave empty to keep the saved password'}"
                                         Visibility="{Binding HasSmtpLogin, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="150,12,0,0" TextWrapping="Wrap"
                                   Text="{local:T 'Most servers use the same sign-in for sending. Unencrypted connections are never used.'}" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="DiagnosticsTab" Header="{local:T 'Diagnostics'}">
                    <Grid Margin="24,18,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:T 'Status:'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ErrorText}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
                            <Button Content="{local:T 'Sync now'}" Padding="12,4" Command="{Binding DataContext.SyncNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="{local:T 'Open log folder'}" Padding="12,4" Margin="8,0,0,0" Command="{Binding DataContext.OpenLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding Folders}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:T 'Folder'}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{local:T 'On server'}" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="{local:T 'Messages'}" Binding="{Binding Messages}" Width="90" />
                                <DataGridTextColumn Header="{local:T 'Unread'}" Binding="{Binding Unread}" Width="80" />
                                <DataGridTextColumn Header="{local:T 'Syncs'}" Binding="{Binding Mode}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
