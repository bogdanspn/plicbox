<UserControl x:Class="Plicbox.App.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plicbox.App.ViewModels"
             xmlns:local="clr-namespace:Plicbox.App"
             FontFamily="{DynamicResource UiFont}" FontSize="14">
    <UserControl.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBool" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- View switcher tab with an underline when active (like eM Client's view buttons). -->
        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="16" />
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="Bar" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource LinkBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A calendar's switch: a square in the calendar's colour (Tag), filled with a tick when shown. -->
        <Style x:Key="CalendarCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="2"
                                    BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent">
                                <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickAddBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource StrongDividerBrush}" BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource HintBrush}" FontStyle="Italic" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewEventCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}" />
        <KeyBinding Key="Home" Modifiers="Control" Command="{Binding GoTodayCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource ToolbarLineBrush}" BorderThickness="0,0,0,1" />
        <!-- ═══ Toolbar: New · Refresh · quick add on the left, views on the right ═══ -->
        <DockPanel Margin="12,0,16,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Height="{StaticResource ToolbarItemHeight}">
                <Button x:Name="NewButton" Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="{local:T 'New'}" Padding="12,6" Click="NewButton_Click"
                        ToolTip="{local:T 'New event (Ctrl+N)'}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{local:T 'New event…'}" Command="{Binding NewEventCommand}" InputGestureText="{local:T 'Ctrl+N'}" />
                            <MenuItem Header="{local:T 'New all-day event…'}" Command="{Binding NewAllDayEventCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource RefreshButton}" Content="{local:T 'Refresh'}" Command="{Binding RefreshCommand}" Margin="10,0,0,0"
                        local:Spin.IsSpinning="{Binding IsBusy}" ToolTip="{Binding RefreshToolTip}" />
                <TextBox x:Name="QuickAdd" Style="{StaticResource QuickAddBox}" Width="380" Height="32" Margin="16,0,0,0"
                         Visibility="{Binding CanQuickAdd, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{local:T 'Quick add: “Lunch with Ana Friday 1pm”'}"
                         ToolTip="{local:T 'Type an event in plain words and press Enter. Google works out the date and time.'}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton Style="{StaticResource ViewTab}" Tag="&#xE8BF;" Content="{local:T 'Day'}" GroupName="CalView"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Day}" />
                <RadioButton Style="{StaticResource ViewTab}" Tag="&#xE8C0;" Content="{local:T 'Work Week'}" GroupName="CalView"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=WorkWeek}" />
                <RadioButton Style="{StaticResource ViewTab}" Tag="&#xE8C0;" Content="{local:T 'Week'}" GroupName="CalView"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Week}" />
                <RadioButton Style="{StaticResource ViewTab}" Tag="&#xE787;" Content="{local:T 'Month'}" GroupName="CalView"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Month}" />
                <RadioButton Style="{StaticResource ViewTab}" Tag="&#xE8FD;" Content="{local:T 'Agenda'}" GroupName="CalView"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Agenda}" />
                <local:ToolbarSearch x:Name="CalendarSearch" Placeholder="{local:T 'Search calendar'}" Text="{Binding SearchText}" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="56" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══ -->
            <!-- Dragged narrow, the sidebar folds into a strip of icons (MainWindow.SyncSidebarWidths) -->
            <local:SidebarRail x:Name="Rail" Visibility="Collapsed" />
            <Grid x:Name="SidebarPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Height="8" />

                <!-- Something needs the user (calendar permission, expired sign-in, API switched off) -->
                <Border Grid.Row="1" Margin="12,0,12,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource WarningFillBrush}" BorderBrush="{DynamicResource WarningStrokeBrush}" BorderThickness="1"
                        Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="13" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BannerAction}" Command="{Binding FixBannerCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5" />
                    </StackPanel>
                </Border>

                <!-- Up next: at the bottom, above the mini month and like it, with a line above that runs on to the white area -->
                <Border Grid.Row="3" Margin="0,0,-8,0" Padding="16,10,26,10" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Headed like the mini month below it -->
                        <TextBlock Text="{local:T 'Up next'}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,6" />
                        <TextBlock Text="{local:T 'Nothing coming up in the next days.'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpNext.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding UpNext}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UpNextItem}">
                                    <Grid Margin="0,4" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="UpNext_MouseDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2" Background="{Binding Color}" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="WhenText" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{local:T 'Join'}" Padding="10,3" FontSize="12"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Visibility="{Binding HasMeeting, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Event}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                            <Setter TargetName="WhenText" Property="Foreground" Value="#E53935" />
                                            <Setter TargetName="WhenText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Calendars, per account -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0" local:Gutter.ScrollBarWidth="8">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarGroupViewModel}">
                                <StackPanel Margin="0,4,0,6">
                                    <StackPanel Orientation="Horizontal" Margin="16,4,18,4" Background="Transparent"
                                                ContextMenuOpening="Account_ContextMenuOpening">
                                        <StackPanel.ContextMenu><ContextMenu /></StackPanel.ContextMenu>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Calendars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarItemViewModel}">
                                                <CheckBox Style="{StaticResource CalendarCheck}" Tag="{Binding Color}" IsChecked="{Binding IsVisible}"
                                                          Margin="34,6,16,6" ToolTip="{Binding Name}" ContextMenuOpening="Calendar_ContextMenuOpening">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <CheckBox.ContextMenu><ContextMenu /></CheckBox.ContextMenu>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Mini month (built in code): a line above it, running on to the white area like the module tabs' -->
                <Border x:Name="MiniMonthHost" Grid.Row="4" Margin="0,0,-8,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource ChromeBrush}" Padding="12,8,20,10" />

                <!-- Module switcher -->
                <Border Grid.Row="5" Height="49" />
            </Grid>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource SidebarSplitter}" />
            <!-- Module tabs: shared out evenly across the sidebar and its splitter, up to the white area (as in eM Client) -->
            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Panel.ZIndex="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <UniformGrid x:Name="ModuleTabs" Rows="1">
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE715;" ToolTip="{local:T 'Mail (Ctrl+1)'}" GroupName="CalModule" Click="MailModule_Click" />
                    <RadioButton x:Name="CalendarModuleButton" Style="{StaticResource ModuleButton}" Content="&#xE787;" ToolTip="{local:T 'Calendar (Ctrl+2)'}" GroupName="CalModule" IsChecked="True" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE77B;" ToolTip="{local:T 'Contacts (Ctrl+3)'}" GroupName="CalModule" Click="ContactsModule_Click" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE930;" ToolTip="{local:T 'Tasks (Ctrl+4)'}" GroupName="CalModule" Click="TasksModule_Click" />
                    <!-- Folds the sidebar into a strip of icons (‹), and opens it again from there (›) -->
                    <Button x:Name="FoldButton" Style="{StaticResource ModuleFoldButton}" Content="&#xE76B;" ToolTip="{local:T 'Collapse sidebar'}" />
                </UniformGrid>
            </Border>

            <!-- ═══ Main: range navigation over the current view ═══ -->
<!-- A divider line along its edge, as between the other panes -->
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource DividerBrush}" />
            <Grid Grid.Column="2" Margin="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <DockPanel Margin="16,10,20,10">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Tag="&#xE76B;" Command="{Binding PreviousCommand}" ToolTip="{local:T 'Previous (Page Up)'}" Padding="8,6" />
                        <Button Style="{StaticResource ToolbarButton}" Tag="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{local:T 'Next (Page Down)'}" Padding="8,6" />
                        <TextBlock Text="{Binding Title}" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" CornerRadius="10" Background="{DynamicResource SubtleFillBrush}" Padding="8,2" VerticalAlignment="Center"
                                Visibility="{Binding WeekLabel, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding WeekLabel}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Tag="&#xE8D1;" Content="{local:T 'Today'}" Command="{Binding GoTodayCommand}"
                            HorizontalAlignment="Right" ToolTip="{local:T 'Today (Ctrl+Home)'}" />
                </DockPanel>
                <!-- With no calendar yet, the views still work: the first event made starts one on this computer. -->
                <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
