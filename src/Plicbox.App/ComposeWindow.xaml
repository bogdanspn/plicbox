<Window x:Class="Plicbox.App.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{local:T 'New message'}" Width="960" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" FontSize="14"
        Background="{DynamicResource SurfaceBrush}" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="HeaderBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style x:Key="HeaderRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Click="Send_Click" ToolTip="{local:T 'Send (Ctrl+Enter)'}" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0" />
                        <TextBlock Text="{local:T 'Send'}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SendLaterButton" Style="{StaticResource ToolbarButton}" Tag="&#xE823;" Content="{local:T 'Send later'}" Click="SendLater_Click" Margin="10,0,0,0"
                        ToolTip="{local:T 'Pick when it goes; it waits in the Outbox until then'}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74E;" Content="{local:T 'Save draft'}" Click="SaveDraft_Click"
                        ToolTip="{local:T 'Save to Drafts (Ctrl+S)'}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Discard'}" Click="Discard_Click" />
                <TextBlock x:Name="SendingSpinner" Style="{StaticResource Spinner}" Margin="16,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Header fields -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource HeaderRow}">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'From'}" Width="60" />
                    <ComboBox x:Name="FromBox" DisplayMemberPath="Label" MinWidth="340" HorizontalAlignment="Left" Margin="0,4" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource HeaderRow}">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'To'}" Width="60" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{local:T 'Cc / Bcc'}" Tag="" Click="ToggleCc_Click" Padding="8,2" />
                    <TextBox x:Name="ToBox" Style="{StaticResource HeaderBox}" />
                </DockPanel>
            </Border>
            <Border x:Name="CcRow" Style="{StaticResource HeaderRow}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'Cc'}" Width="60" />
                    <TextBox x:Name="CcBox" Style="{StaticResource HeaderBox}" />
                </DockPanel>
            </Border>
            <Border x:Name="BccRow" Style="{StaticResource HeaderRow}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'Bcc'}" Width="60" />
                    <TextBox x:Name="BccBox" Style="{StaticResource HeaderBox}" />
                </DockPanel>
            </Border>
            <Border x:Name="ReplyToRow" Style="{StaticResource HeaderRow}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'Reply to'}" Width="60" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="6,2" ToolTip="{local:T 'Remove reply-to address'}"
                            Click="RemoveReplyTo_Click" />
                    <TextBox x:Name="ReplyToBox" Style="{StaticResource HeaderBox}" ToolTip="{local:T 'Replies go to this address instead of the From address'}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource HeaderRow}">
                <DockPanel>
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="{local:T 'Subject'}" Width="60" />
                    <TextBox x:Name="SubjectBox" Style="{StaticResource HeaderBox}" FontWeight="SemiBold" TextChanged="Subject_TextChanged" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Attachments: one that may not get through is coloured like a risky attachment when reading, with why under the list -->
        <StackPanel Grid.Row="2" Margin="16,6,16,0">
            <ItemsControl x:Name="AttachmentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" Background="{DynamicResource SubtleFillBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                                Padding="10,4,4,4" Margin="4" ToolTip="{Binding Warning.Text}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipIcon" Style="{StaticResource Icon}" Text="&#xE723;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="6,2" Margin="4,0,0,0" ToolTip="{local:T 'Remove'}"
                                        Click="RemoveAttachment_Click" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource CautionFillBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource CautionStrokeBrush}" />
                                <Setter TargetName="ChipIcon" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerFillBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource DangerStrokeBrush}" />
                                <Setter TargetName="ChipIcon" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="AttachmentWarningList" Margin="4,2,4,2" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock x:Name="WarnIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource CautionTextBrush}" />
                            <TextBlock x:Name="WarnText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource CautionTextBrush}" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Risk}" Value="Danger">
                                <Setter TargetName="WarnIcon" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                <Setter TargetName="WarnText" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <wv2:WebView2 x:Name="Editor" Grid.Row="3" Margin="0,6,0,0" DefaultBackgroundColor="White" />

        <!-- Shown while files are dragged over the window outside the text: they'll be attached. Over the toolbar,
             header and attachments only; the editor page shows its own hint (WPF can't draw over it). -->
        <Border x:Name="DropHint" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Margin="6"
                Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" CornerRadius="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="18" Foreground="{DynamicResource LinkBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{local:T 'Drop to attach'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource LinkBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
