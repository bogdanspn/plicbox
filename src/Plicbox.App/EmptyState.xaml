<UserControl x:Class="Plicbox.App.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,24,24,72">
    <!-- What an empty list or a search with no results shows, in the middle of its pane (a little above, where the eye
         rests): an icon in a soft circle, what happened, what to try, and an optional button under it (Clear search,
         New contact). -->
    <StackPanel MaxWidth="380">
        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SubtleFillBrush}" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph, ElementName=Root}" FontSize="26" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBlock x:Name="Detail" Text="{Binding Text, ElementName=Root}" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
        <Button x:Name="Action" Style="{StaticResource ToolbarButton}" Tag="{Binding ActionGlyph, ElementName=Root}" Content="{Binding ActionText, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="10,5" />
    </StackPanel>
</UserControl>
