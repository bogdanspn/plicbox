<Window x:Class="Plicbox.App.EventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Width="660" SizeToContent="Height" MaxHeight="900" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="RowGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="JoinButton" Style="{StaticResource ToolbarButton}" Tag="&#xE714;" Content="{local:T 'Join call'}" Click="Join_Click" Visibility="Collapsed" />
                    <Button x:Name="GoogleButton" Style="{StaticResource ToolbarButton}" Tag="&#xE8A7;" Content="{local:T 'Open in Google'}" Click="OpenInGoogle_Click" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="14,7" ToolTip="{local:T 'Save &amp; Close (Ctrl+S)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                            <TextBlock x:Name="SaveLabel" Text="{local:T 'Save &amp; Close'}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Content="{local:T 'Cancel'}" Margin="10,0,0,0" Padding="14,6" Click="Cancel_Click" />
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete'}" Click="Delete_Click" Margin="10,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="SavingSpinner" Style="{StaticResource Spinner}" Margin="14,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,24">
                <!-- Invitation answer, when someone else invited me -->
                <Border x:Name="RsvpBar" Background="{DynamicResource InfoFillBrush}" BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="YesButton" Content="{local:T 'Yes'}" MinWidth="70" Padding="10,4" Click="Rsvp_Click" Tag="accepted" />
                            <Button x:Name="MaybeButton" Content="{local:T 'Maybe'}" MinWidth="70" Padding="10,4" Margin="6,0" Click="Rsvp_Click" Tag="tentative" />
                            <Button x:Name="NoButton" Content="{local:T 'No'}" MinWidth="70" Padding="10,4" Click="Rsvp_Click" Tag="declined" />
                        </StackPanel>
                        <TextBlock x:Name="RsvpText" VerticalAlignment="Center" TextWrapping="Wrap" Text="{local:T 'Going?'}" />
                    </DockPanel>
                </Border>

                <TextBox x:Name="TitleBox" FontSize="20" Padding="10,6" local:Placeholder.Text="{local:T 'Add a title'}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Calendar -->
                    <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE787;" />
                    <ComboBox x:Name="CalendarBox" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="320" SelectionChanged="Calendar_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Color}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Account}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- When -->
                    <TextBlock Grid.Row="1" Style="{StaticResource RowGlyph}" Text="&#xE823;" VerticalAlignment="Top" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6">
                        <WrapPanel>
                            <DatePicker x:Name="StartDate" Width="150" SelectedDateChanged="When_Changed" />
                            <ComboBox x:Name="StartTime" Width="100" IsEditable="True" Margin="6,0,0,0" SelectionChanged="StartTime_Changed" LostFocus="When_Changed" />
                            <TextBlock Text="–" Margin="10,0" VerticalAlignment="Center" />
                            <DatePicker x:Name="EndDate" Width="150" SelectedDateChanged="When_Changed" />
                            <ComboBox x:Name="EndTime" Width="100" IsEditable="True" Margin="6,0,0,0" SelectionChanged="When_Changed" LostFocus="When_Changed" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="AllDayBox" Content="{local:T 'All day'}" Checked="AllDay_Changed" Unchecked="AllDay_Changed" />
                            <TextBlock x:Name="DurationText" Style="{StaticResource Hint}" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Repeat -->
                    <TextBlock Grid.Row="2" Style="{StaticResource RowGlyph}" Text="&#xE8EE;" />
                    <ComboBox x:Name="RepeatBox" Grid.Row="2" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="320" DisplayMemberPath="Label" />

                    <!-- Location -->
                    <TextBlock Grid.Row="3" Style="{StaticResource RowGlyph}" Text="&#xE707;" />
                    <TextBox x:Name="LocationBox" Grid.Row="3" Grid.Column="1" Margin="0,4" local:Placeholder.Text="{local:T 'Add a location'}" />

                    <!-- Video call (Google's: not for a calendar on this computer) -->
                    <TextBlock x:Name="VideoGlyph" Grid.Row="4" Style="{StaticResource RowGlyph}" Text="&#xE714;" />
                    <StackPanel x:Name="VideoRow" Grid.Row="4" Grid.Column="1" Margin="0,6">
                        <CheckBox x:Name="VideoBox" Content="{local:T 'Add a Google Meet video call'}" />
                        <TextBlock x:Name="MeetingLinkText" Visibility="Collapsed" TextTrimming="CharacterEllipsis">
                            <Hyperlink x:Name="MeetingLink" Style="{StaticResource QuietLink}" Click="Join_Click" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Guests (invitations go out through Google: not for a calendar on this computer) -->
                    <TextBlock x:Name="GuestsGlyph" Grid.Row="5" Style="{StaticResource RowGlyph}" Text="&#xE716;" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <StackPanel x:Name="GuestsRow" Grid.Row="5" Grid.Column="1" Margin="0,4">
                        <TextBox x:Name="GuestsBox" local:Placeholder.Text="{local:T 'Invite people (addresses, separated by commas)'}" />
                        <ItemsControl x:Name="AttendeeList" Margin="2,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="12" Width="18" />
                                        <TextBlock Text="{Binding Label}" FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Reminder + busy -->
                    <TextBlock Grid.Row="6" Style="{StaticResource RowGlyph}" Text="&#xEA8F;" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <ComboBox x:Name="ReminderBox" MinWidth="200" DisplayMemberPath="Label" />
                        <ComboBox x:Name="BusyBox" MinWidth="130" Margin="10,0,0,0">
                            <ComboBoxItem Content="{local:T 'Show as busy'}" />
                            <ComboBoxItem Content="{local:T 'Show as free'}" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Notes -->
                    <TextBlock Grid.Row="7" Style="{StaticResource RowGlyph}" Text="&#xE8A5;" VerticalAlignment="Top" Margin="0,10,0,0" />
                    <TextBox x:Name="NotesBox" local:Placeholder.Text="{local:T 'Add notes or a description'}" Grid.Row="7" Grid.Column="1" Margin="0,4" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="110" MaxHeight="260" VerticalScrollBarVisibility="Auto" />

                    <TextBlock x:Name="ReadOnlyText" Grid.Row="8" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
