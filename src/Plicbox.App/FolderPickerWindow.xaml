<Window x:Class="Plicbox.App.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Width="440" Height="560" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
        <TextBox x:Name="FilterBox" Grid.Row="1" Style="{StaticResource SearchBox}" Height="32" Margin="0,0,0,10" Tag="{local:T 'Filter folders'}"
                 TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown" />
        <ListBox x:Name="FolderList" Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                 MouseDoubleClick="FolderList_MouseDoubleClick" SelectionChanged="FolderList_SelectionChanged">
            <ListBox.GroupStyle>
                <!-- One heading per account, so two accounts' "Archive" can't be mixed up. -->
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,10,0,4">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <local:GlyphIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{local:T 'Cancel'}" IsCancel="True" MinWidth="100" Padding="14,6" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="100" Padding="14,6" Margin="10,0,0,0"
                    IsEnabled="False" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
