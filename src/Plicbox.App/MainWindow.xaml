<Window x:Class="Plicbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plicbox.App.ViewModels"
        xmlns:local="clr-namespace:Plicbox.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Plicbox" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ToggleReadCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ArchiveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <local:IndentConverter x:Key="Indent" Step="18" />
        <local:GroupOpenConverter x:Key="GroupOpen" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <!-- Message list column headers: click to sort, click again to reverse. -->
        <Style x:Key="ColumnHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SortCaret" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="5,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="52" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- ═══ Title bar: menu · centered search · caption buttons ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Same size and look as the minimize/maximize/close buttons on the other side; the module's name beside it -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="MenuButton" Style="{StaticResource MenuCaptionButton}" Content="&#xE700;" VerticalAlignment="Top"
                    ToolTip="{local:T 'Menu'}" Click="Menu_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{local:T 'Settings…'}" Command="{Binding OpenSettingsCommand}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:T 'Accounts…'}" Command="{Binding OpenAccountsCommand}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:T 'Rules…'}" Command="{Binding OpenRulesCommand}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:T 'Add account…'}" Command="{Binding AddAccountCommand}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:T 'Sync all accounts'}" Command="{Binding RefreshCommand}" InputGestureText="F5">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{local:T 'About Plicbox'}" Click="About_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:T 'Exit'}" Click="Exit_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="16" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Border Height="36" Margin="4,0,0,0">
                <TextBlock x:Name="ModuleTitle" Text="{local:T 'Mail'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <!-- A build started from the source tree, so it can't be mistaken for the installed Plicbox running beside it -->
            <Border x:Name="DevChip" Background="{DynamicResource SubtleFillBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                    VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{local:T 'A development build: it doesn\'t update itself and leaves starting with Windows to the installed Plicbox.'}">
                <TextBlock Text="DEV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{local:T 'Minimize'}" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{local:T 'Maximize'}" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{local:T 'Close'}" />
            </StackPanel>
        </Grid>

        <!-- ═══ Toolbar: New · Refresh · sync status on the left, message actions on the right ═══
             Snooze and Quick Actions live in ⋯; as the window narrows, more actions fold into it (see FitToolbar), least important first. -->
        <Border x:Name="ToolbarLine" Grid.Row="1" BorderBrush="{DynamicResource ToolbarLineBrush}" BorderThickness="0,0,0,1" />
        <DockPanel x:Name="ToolbarRow" Grid.Row="1" Margin="12,0,16,0" LastChildFill="True">
            <StackPanel x:Name="LeftTools" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Height="{StaticResource ToolbarItemHeight}">
                <Button x:Name="MailNewButton" Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="{local:T 'New'}" Click="MailNew_Click" Padding="12,6"
                        ToolTip="{local:T 'New mail (Ctrl+N) · the arrow has everything else'}" />
                <Button Style="{StaticResource RefreshButton}" Content="{local:T 'Refresh'}" Command="{Binding RefreshCommand}" Margin="10,0,0,0"
                        local:Spin.IsSpinning="{Binding IsSyncing}" ToolTip="{Binding RefreshToolTip}" />
                <Button Style="{StaticResource DropButton}" Tag="Refresh" Click="Dropdown_Click" ToolTip="{local:T 'More sync options'}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Undo send: the message just sent waits a few seconds in the Outbox -->
                <TextBlock Text="{Binding SendNote}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding SendNote}"
                           Visibility="{Binding SendNote, Converter={StaticResource NullToCollapsed}}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE7A7;" Content="{local:T 'Undo'}" Margin="4,0,0,0"
                        Foreground="{DynamicResource LinkBrush}" Command="{Binding UndoSendCommand}"
                        Visibility="{Binding CanUndoSend, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE77B;" Content="{local:T 'Sign in again…'}" Margin="6,0,0,0"
                        Foreground="{DynamicResource LinkBrush}" Command="{Binding SignInFromStatusCommand}"
                        Visibility="{Binding SignInNeededFor, Converter={StaticResource NullToCollapsed}}" />
                <!-- A new version is downloaded: it installs on quit anyway; this does it now -->
                <Button x:Name="UpdateNote" Style="{StaticResource ToolbarButton}" Tag="&#xE777;" Content="{local:T 'Restart to update'}" Margin="10,0,0,0"
                        Foreground="{DynamicResource LinkBrush}" Command="{Binding RestartCommand}" ToolTip="{Binding Status}"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- Search, always open at the right end (Ctrl+F) -->
            <local:ToolbarSearch x:Name="MailSearch" DockPanel.Dock="Right" Placeholder="{Binding SearchPlaceholder}" Text="{Binding SearchText}" Margin="8,0,0,0"
                                 HasOptions="True" OptionsActive="{Binding IsSearchNarrowed}" OptionsClick="SearchOptions_Click" />
            <StackPanel x:Name="ActionBar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Height="{StaticResource ToolbarItemHeight}">
                <Button x:Name="ReplyButton" Style="{StaticResource ToolbarButton}" Tag="&#xE97A;" Content="{local:T 'Reply'}" Command="{Binding ReplyCommand}" />
                <Button x:Name="ReplyAllGroup" Style="{StaticResource ToolbarButton}" Tag="&#xE8C2;" Content="{local:T 'Reply All'}" Command="{Binding ReplyAllCommand}" />
                <StackPanel x:Name="ForwardGroup" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xEE35;" Content="{local:T 'Forward'}" Command="{Binding ForwardCommand}" />
                    <Button Style="{StaticResource DropButton}" Tag="Forward" Click="Dropdown_Click" ToolTip="{local:T 'More ways to forward'}" />
                </StackPanel>
                <StackPanel x:Name="MarkGroup" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE8C3;" Content="{local:T 'Mark'}" Command="{Binding ToggleReadCommand}" ToolTip="{local:T 'Toggle read (Ctrl+Q)'}" />
                    <Button Style="{StaticResource DropButton}" Tag="Mark" Click="Dropdown_Click" ToolTip="{local:T 'Flag, read, unread, junk'}" />
                </StackPanel>
                <Button x:Name="FlagGroup" Style="{StaticResource ToolbarButton}" Tag="&#xE7C1;" Content="{local:T 'Flag'}" Command="{Binding ToggleFlagCommand}" />
                <Button x:Name="ArchiveGroup" Style="{StaticResource ToolbarButton}" Tag="&#xE7B8;" Content="{local:T 'Archive'}" Command="{Binding ArchiveCommand}" ToolTip="{local:T 'Archive (Ctrl+E)'}" />
                <Button x:Name="DeleteGroup" Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete'}" Command="{Binding DeleteCommand}" ToolTip="{local:T 'Delete (Del)'}" />
                <!-- ⋯: Snooze, Quick Actions, and whatever doesn't fit -->
                <Button x:Name="MoreGroup" Style="{StaticResource ToolbarButton}" Tag="&#xE712;" Click="More_Click" Padding="9,6" ToolTip="{local:T 'More actions'}" />
            </StackPanel>
        </DockPanel>

        <!-- ═══ Main area: sidebar | list over reading pane ═══ -->
        <Grid x:Name="MailArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="56" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <!-- Dragged narrow, the sidebar folds into a strip of icons (MainWindow.SyncSidebarWidths) -->
            <local:SidebarRail x:Name="Rail" Visibility="Collapsed" />
            <Grid x:Name="SidebarPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Height="8" />
                <ListBox x:Name="SidebarList" Grid.Row="1" ItemsSource="{Binding SidebarView}" SelectedItem="{Binding SelectedNode}"
                         AllowDrop="True" DragOver="Sidebar_DragOver" DragLeave="Sidebar_DragLeave" Drop="Sidebar_Drop"
                         ContextMenuOpening="Sidebar_ContextMenuOpening" PreviewMouseRightButtonDown="Sidebar_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="Sidebar_PreviewMouseRightButtonUp"
                         ItemContainerStyle="{StaticResource SidebarItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0" local:Gutter.ScrollBarWidth="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SidebarNode}">
                            <Grid x:Name="NodeRoot" Background="Transparent">
                                <Button x:Name="GroupRow" Style="{StaticResource BareButton}" Height="33"
                                        Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <!-- The collapse arrow at the right, so accounts start where Calendar's and Tasks' do (with every
                                         level 18 further in, as there). A folded "More" shows its folders' unread total next to it. -->
                                    <DockPanel Margin="{Binding Level, Converter={StaticResource Indent}, ConverterParameter='16,18'}">
                                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Width="14"
                                                   TextAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="GroupCount" DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource CountBrush}"
                                                   FontWeight="SemiBold" FontSize="13" Margin="8,0,8,0" VerticalAlignment="Center" />
                                        <local:GlyphIcon x:Name="GroupGlyph" Glyph="{Binding Glyph}" FontSize="16" Margin="0,0,12,0" />
                                        <TextBlock x:Name="GroupTitle" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                                <!-- Same column for every row's icon at a given depth (16 + 18 per level), groups' included. -->
                                <Grid x:Name="LeafRow" Margin="{Binding Level, Converter={StaticResource Indent}, ConverterParameter='16,18'}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:GlyphIcon x:Name="LeafGlyph" Glyph="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="LeafTitle" Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CountText" Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource CountBrush}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <!-- A folder action running on the server: the message list's busy ring in the count's place (it turns only while shown) -->
                                    <local:BusyRing x:Name="BusySpot" Grid.Column="2" Width="12" Height="12" Thickness="1.5" VerticalAlignment="Center"
                                                    Visibility="Collapsed" ToolTip="{local:T 'Working on it…'}" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="LeafRow" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGroup}" Value="False">
                                    <Setter TargetName="GroupRow" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="1">
                                    <Setter TargetName="GroupTitle" Property="FontWeight" Value="Normal" />
                                    <Setter TargetName="GroupGlyph" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Count}" Value="0">
                                    <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="GroupCount" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="BusySpot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CountIsTotal}" Value="True">
                                    <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Setter TargetName="CountText" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasGlyphColor}" Value="True">
                                    <Setter TargetName="LeafGlyph" Property="Foreground" Value="{Binding GlyphBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="LeafGlyph" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                    <Setter TargetName="LeafTitle" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Module switcher -->
                <Border Grid.Row="2" Height="49" />
            </Grid>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource SidebarSplitter}" />
            <!-- Module tabs: shared out evenly across the sidebar and its splitter, up to the white area (as in eM Client) -->
            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Panel.ZIndex="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <UniformGrid x:Name="ModuleTabs" Rows="1">
                    <RadioButton x:Name="MailModuleButton" Style="{StaticResource ModuleButton}" Content="&#xE715;" IsChecked="True" ToolTip="{local:T 'Mail (Ctrl+1)'}" GroupName="Module" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE787;" ToolTip="{local:T 'Calendar (Ctrl+2)'}" GroupName="Module" Click="CalendarModule_Click" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE77B;" ToolTip="{local:T 'Contacts (Ctrl+3)'}" GroupName="Module" Click="ContactsModule_Click" />
                    <RadioButton x:Name="TasksModuleButton" Style="{StaticResource ModuleButton}" Content="&#xE930;" ToolTip="{local:T 'Tasks (Ctrl+4)'}" GroupName="Module" Click="TasksModule_Click" />
                    <!-- Folds the sidebar into a strip of icons (‹), and opens it again from there (›) -->
                    <Button x:Name="FoldButton" Style="{StaticResource ModuleFoldButton}" Content="&#xE76B;" ToolTip="{local:T 'Collapse sidebar'}" />
                </UniformGrid>
            </Border>

            <!-- Message list over reading pane -->
<!-- A divider line along its edge, as between the other panes; the content starts after it (the message view is a browser window, which nothing can be drawn over) -->
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource DividerBrush}" />
            <!-- Rows and columns are set for the reading pane layout (Settings → Appearance) in ApplyReadingLayout:
                 under the list (rows 2-3), beside it (columns 1-2), in its place, or none. -->
            <Grid x:Name="MailPane" Grid.Column="2" Margin="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="34" />
                    <RowDefinition x:Name="ListRow" Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ReadingRow" Height="3*" MinHeight="160" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ReadingColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- Reading pane on the right: the list's rows are narrow, so the columns give way to a sort menu -->
                <Border x:Name="CompactHeader" Visibility="Collapsed" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Button x:Name="CompactSortButton" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Left" Margin="6,0,0,0" Padding="8,0"
                            Click="CompactSort_Click" ToolTip="{local:T 'Sort the list'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactSortText" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Column header (widths mirror the row template below); click a column to sort by it -->
                <Grid x:Name="ListHeader" Background="{DynamicResource SurfaceBrush}" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="Flag"
                            HorizontalContentAlignment="Center" Padding="0" ToolTip="{local:T 'Sort by flag'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="14" />
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding FlagCaret}" Margin="2,1,0,0" />
                        </StackPanel>
                    </Button>
                    <!-- An eye: read or not. The column is narrow, so the sort arrow hangs off its right edge and the eye
                         stays centred over the unread dots below. -->
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="ReadStatus"
                            HorizontalContentAlignment="Center" Padding="0" ToolTip="{local:T 'Sort by read status'}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE890;" FontSize="14" />
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding ReadStatusCaret}" HorizontalAlignment="Right" Margin="0,1,-11,0" />
                        </Grid>
                    </Button>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE77B;" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="From" ToolTip="{local:T 'Sort by sender'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:T 'From'}" />
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding FromCaret}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="Subject" ToolTip="{local:T 'Sort by subject'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:T 'Subject'}" />
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding SubjectCaret}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="Received"
                            HorizontalContentAlignment="Right" Padding="4,0,0,0" ToolTip="{local:T 'Sort by date received'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding ReceivedCaret}" Margin="0,1,5,0" />
                            <TextBlock Text="{local:T 'Received'}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource ColumnHeader}" Command="{Binding SortByCommand}" CommandParameter="Attachments"
                            HorizontalContentAlignment="Center" Padding="0" ToolTip="{local:T 'Sort by attachments'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="14" />
                            <TextBlock Style="{StaticResource SortCaret}" Text="{Binding AttachmentsCaret}" Margin="2,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Grid.ColumnSpan="7" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,-12,0" IsHitTestVisible="False" />
                </Grid>

                <ListBox x:Name="MessageList" Grid.Row="1" SelectionMode="Extended"
                         PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown" PreviewMouseMove="MessageList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="MessageList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="MessageList_MouseDoubleClick"
                         ItemsSource="{Binding MessagesView}" SelectedItem="{Binding SelectedMessage}"
                         ItemContainerStyle="{StaticResource MessageItem}" AlternationCount="2"
                         BorderThickness="0" Background="{DynamicResource SurfaceBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.Resources>
                        <!-- Reading pane on the right: the list is narrow, so each message takes two lines (sender and time;
                             subject, attachment, conversation and flag), as in eM Client's and Outlook's narrow lists. -->
                        <Style x:Key="CompactRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource MessageItem}">
                            <Setter Property="Height" Value="62" />
                        </Style>
                        <DataTemplate x:Key="CompactRow" DataType="{x:Type vm:MessageItemViewModel}">
                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Ellipse x:Name="UnreadDot" Grid.RowSpan="2" Width="8" Height="8" Fill="{DynamicResource UnreadDotBrush}" Visibility="Collapsed" />
                                <Grid x:Name="Avatar" Grid.Column="1" Grid.RowSpan="2" Width="30" Height="30" HorizontalAlignment="Left">
                                    <Ellipse Fill="{Binding AvatarBrush}" />
                                    <local:CenteredInitial Text="{Binding Initial}" Scale="0.46" />
                                    <Grid x:Name="PictureLayer">
                                        <Ellipse Fill="White" Margin="0.5" />
                                        <Ellipse Stroke="{DynamicResource AvatarRingBrush}" StrokeThickness="0.5" Margin="-0.75">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="SenderText" Grid.Column="2" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <local:BusyRing x:Name="BusyGlyph" Width="12" Height="12" Thickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Visibility="Collapsed" ToolTip="{local:T 'Working on it…'}" />
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ImportantBrush}" Margin="0,1,8,0" VerticalAlignment="Center"
                                             ToolTip="{local:T 'Important'}" Visibility="{Binding IsImportant, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock x:Name="TimeText" Text="{Binding DisplayTime}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,2,10,0">
                                    <Border x:Name="FolderChip" DockPanel.Dock="Left" Background="{DynamicResource SubtleFillBrush}" CornerRadius="3" Padding="6,0" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{Binding FolderHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>
                                    <TextBlock x:Name="SubjectText" Text="{Binding Subject}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <TextBlock x:Name="AttachGlyph" Style="{StaticResource Icon}" Text="&#xE723;" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <Button x:Name="ThreadBadge" Style="{StaticResource BareButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="Collapsed" ToolTip="{local:T 'Show or hide the conversation (→ / ←)'}"
                                            Command="{Binding DataContext.ToggleThreadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Border x:Name="BadgeBox" Background="#8C8C8C" CornerRadius="4" Height="18" MinWidth="32" Padding="6,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" TextElement.Foreground="White">
                                                <local:InkText Text="{Binding ThreadCount}" FontSize="11.5" FontWeight="SemiBold" />
                                                <local:InkText x:Name="BadgeChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Style="{StaticResource BareButton}" ToolTip="{local:T 'Flag'}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleFlagCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock x:Name="FlagGlyph" Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Opacity="0" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Picture}" Value="{x:Null}">
                                    <Setter TargetName="PictureLayer" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="FlagGlyph" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                    <Setter TargetName="FlagGlyph" Property="Opacity" Value="1" />
                                    <Setter TargetName="FlagGlyph" Property="Foreground" Value="{DynamicResource FlagBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter TargetName="UnreadDot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SenderText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter TargetName="TimeText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsThread}" Value="True">
                                    <Setter TargetName="ThreadBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource LinkBrush}" />
                                    <Setter TargetName="BadgeChevron" Property="Text" Value="&#xE70D;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsThreadChild}" Value="True">
                                    <Setter TargetName="Avatar" Property="Margin" Value="12,0,0,0" />
                                    <Setter TargetName="Avatar" Property="Width" Value="22" />
                                    <Setter TargetName="Avatar" Property="Height" Value="22" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFolderHint}" Value="True">
                                    <Setter TargetName="FolderChip" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Model.HasAttachments}" Value="True">
                                    <Setter TargetName="AttachGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter TargetName="BusyGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.Resources>
                    <!-- Explicit, because the Fluent theme's list template doesn't virtualize: without this every row
                         (hundreds) was built on each folder switch, which took ~1 s. -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="MessageMenu_Opened">
                            <MenuItem Header="{local:T 'Open'}" Command="{Binding OpenMessageCommand}" InputGestureText="{local:T 'Double-click'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Send Now'}" Command="{Binding SendNowCommand}"
                                      Visibility="{Binding SelectedInOutbox, Converter={StaticResource BoolToVisibility}}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'Reply'}" Command="{Binding ReplyCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE97A;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Reply All'}" Command="{Binding ReplyAllCommand}">
                                <MenuItem.Icon><local:GlyphIcon Glyph="&#xE8C2;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Forward'}" Command="{Binding ForwardCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEE35;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'Flag'}" Command="{Binding ToggleFlagCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Create Task…'}" Click="CreateTask_Click" IsEnabled="{Binding HasSelection}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Mark as Read'}" Command="{Binding MarkReadCommand}" InputGestureText="{local:T 'Ctrl+Q'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C3;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Mark as Unread'}" Command="{Binding MarkUnreadCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'Save As…'}" Command="{Binding SaveAsCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Delete'}" Command="{Binding DeleteCommand}" InputGestureText="{local:T 'Del'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'Copy to Folder…'}" Command="{Binding CopyToFolderCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Move to Folder…'}" Command="{Binding MoveToFolderCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Move to Junk'}" Command="{Binding MoveToJunkCommand}" Visibility="{Binding SelectedInJunk, Converter={StaticResource InverseBoolToVisibility}}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Not Junk'}" Command="{Binding NotJunkCommand}" Visibility="{Binding SelectedInJunk, Converter={StaticResource BoolToVisibility}}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Move to Archive'}" Command="{Binding ArchiveCommand}" InputGestureText="{local:T 'Ctrl+E'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Block'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE733;" FontSize="16" /></MenuItem.Icon>
                                <MenuItem Header="{Binding RuleSender}" HeaderStringFormat="{local:T 'Block {0}…'}" Command="{Binding BlockSenderCommand}" CommandParameter="sender" />
                                <MenuItem Header="{Binding BlockDomain}" HeaderStringFormat="{local:T 'Block everyone at {0}…'}" Command="{Binding BlockSenderCommand}" CommandParameter="domain"
                                          Visibility="{Binding BlockDomain, Converter={StaticResource NullToCollapsed}}" />
                                <Separator />
                                <MenuItem Header="{local:T 'Manage blocked senders…'}" Command="{Binding OpenSendersSettingsCommand}" />
                            </MenuItem>
                            <MenuItem Header="{local:T 'Create Rule'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="16" /></MenuItem.Icon>
                                <MenuItem Header="{Binding RuleSender}" HeaderStringFormat="{local:T 'Move mail from {0} to…'}" Command="{Binding CreateRuleCommand}" CommandParameter="move-sender">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" FontSize="16" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding RuleSubjectHeader}" Command="{Binding CreateRuleCommand}" CommandParameter="move-subject">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="16" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding RuleSender}" HeaderStringFormat="{local:T 'Always mark mail from {0} as read'}" Command="{Binding CreateRuleCommand}" CommandParameter="read-sender">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C3;" FontSize="16" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding RuleSender}" HeaderStringFormat="{local:T 'Delete mail from {0}'}" Command="{Binding CreateRuleCommand}" CommandParameter="delete-sender">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{local:T 'Custom Rule…'}" Command="{Binding CreateRuleCommand}" CommandParameter="custom">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="16" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'Print…'}" Command="{Binding PrintCommand}" InputGestureText="{local:T 'Ctrl+P'}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'Download for offline use'}" Command="{Binding DownloadOfflineCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:T 'View Mail Header'}" Command="{Binding ViewHeadersCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xF0E3;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:T 'View Mail Source'}" Command="{Binding ViewSourceCommand}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="16" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                        <KeyBinding Key="Right" Command="{Binding ExpandThreadCommand}" />
                        <KeyBinding Key="Left" Command="{Binding CollapseSelectedThreadCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.GroupStyle>
                        <!-- Date headings fold their group away (and back); folded ones stay so while the app runs. -->
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ToggleButton x:Name="Header" Focusable="False" Cursor="Hand" HorizontalAlignment="Stretch"
                                                                  IsChecked="{Binding Name, Converter={StaticResource GroupOpen}, Mode=OneTime}"
                                                                  Checked="MessageGroup_Toggled" Unchecked="MessageGroup_Toggled">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Left" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <StackPanel Orientation="Horizontal" Margin="12,14,0,6">
                                                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Width="10"
                                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" />
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                                                            <!-- Folded: how many messages it holds -->
                                                            <TextBlock x:Name="Count" Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="14" Visibility="Collapsed" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ItemsPresenter x:Name="Rows" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="Header" Property="IsChecked" Value="False">
                                                        <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                                        <Setter TargetName="Count" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource BareButton}" ToolTip="{local:T 'Flag'}"
                                        Command="{Binding DataContext.ToggleFlagCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock x:Name="FlagGlyph" Style="{StaticResource Icon}" Text="&#xE7C1;" HorizontalAlignment="Center"
                                               FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Opacity="0" />
                                </Button>
                                <Ellipse x:Name="UnreadDot" Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource UnreadDotBrush}" Visibility="Collapsed" />
                                <Grid x:Name="Avatar" Grid.Column="2" Width="26" Height="26">
                                    <Ellipse Fill="{Binding AvatarBrush}" />
                                    <local:CenteredInitial Text="{Binding Initial}" Scale="0.46" />
                                    <!-- The sender's picture, when there is one, covers the letter (white behind for transparent logos). -->
                                    <Grid x:Name="PictureLayer">
                                        <Ellipse Fill="White" Margin="0.5" />
                                        <Ellipse Stroke="{DynamicResource AvatarRingBrush}" StrokeThickness="0.5" Margin="-0.75">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="SenderText" Grid.Column="3" Text="{Binding Sender}" Margin="4,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <!-- The conversation count sits at the subject's right end, so only threaded rows give up room for it. -->
                                <DockPanel Grid.Column="4" Margin="4,0,12,0" VerticalAlignment="Center">
                                    <Button x:Name="ThreadBadge" DockPanel.Dock="Right" Style="{StaticResource BareButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="Collapsed" ToolTip="{local:T 'Show or hide the conversation (→ / ←)'}"
                                            Command="{Binding DataContext.ToggleThreadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <!-- Number and chevron centred by their ink, not their line boxes (which sit them low, by how much depends on the font). -->
                                        <Border x:Name="BadgeBox" Background="#8C8C8C" CornerRadius="4" Height="20" MinWidth="36" Padding="7,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" TextElement.Foreground="White">
                                                <local:InkText Text="{Binding ThreadCount}" FontSize="12" FontWeight="SemiBold" />
                                                <local:InkText x:Name="BadgeChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border x:Name="FolderChip" DockPanel.Dock="Left" Background="{DynamicResource SubtleFillBrush}" CornerRadius="3" Padding="6,0" Margin="0,0,8,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{Binding FolderHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>
                                    <TextBlock x:Name="SubjectText" Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <!-- Gmail's Important: a small amber dot just left of the time (the subject keeps its place) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Turns while something happens to the message in the background (downloading it, sending a change to the server). -->
                                    <local:BusyRing x:Name="BusyGlyph" Width="12" Height="12" Thickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Visibility="Collapsed" ToolTip="{local:T 'Working on it…'}" />

                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ImportantBrush}" Margin="0,1,8,0" VerticalAlignment="Center"
                                             ToolTip="{local:T 'Important'}" Visibility="{Binding IsImportant, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock x:Name="TimeText" Text="{Binding DisplayTime}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="AttachGlyph" Grid.Column="6" Style="{StaticResource Icon}" Text="&#xE723;" HorizontalAlignment="Center"
                                           FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Picture}" Value="{x:Null}">
                                    <Setter TargetName="PictureLayer" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="FlagGlyph" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                    <Setter TargetName="FlagGlyph" Property="Opacity" Value="1" />
                                    <Setter TargetName="FlagGlyph" Property="Foreground" Value="{DynamicResource FlagBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter TargetName="UnreadDot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SenderText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="TimeText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsThread}" Value="True">
                                    <Setter TargetName="ThreadBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="BadgeBox" Property="Background" Value="{DynamicResource LinkBrush}" />
                                    <Setter TargetName="BadgeChevron" Property="Text" Value="&#xE70D;" />
                                </DataTrigger>
                                <!-- Rows of an opened conversation: indented, smaller avatar -->
                                <DataTrigger Binding="{Binding IsThreadChild}" Value="True">
                                    <Setter TargetName="Avatar" Property="Margin" Value="14,0,0,0" />
                                    <Setter TargetName="Avatar" Property="Width" Value="20" />
                                    <Setter TargetName="Avatar" Property="Height" Value="20" />
                                    <Setter TargetName="SenderText" Property="Margin" Value="26,0,12,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFolderHint}" Value="True">
                                    <Setter TargetName="FolderChip" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Model.HasAttachments}" Value="True">
                                    <Setter TargetName="AttachGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter TargetName="BusyGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty list: which kind of folder is empty, or a search that found nothing (with a way on) -->
                <local:EmptyState Grid.Row="1" Glyph="{Binding ListEmptyGlyph}" Title="{Binding ListEmptyTitle}" Text="{Binding ListEmptyText}"
                                  ActionText="{Binding ListEmptyAction}" ActionGlyph="{Binding ListEmptyActionGlyph}" ActionCommand="{Binding ListEmptyCommand}"
                                  Margin="24">
                    <local:EmptyState.Style>
                        <Style TargetType="local:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasItems, ElementName=MessageList}" Value="False" />
                                        <Condition Binding="{Binding HasAccounts}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:EmptyState.Style>
                </local:EmptyState>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{local:T 'Welcome to Plicbox'}" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T 'Add your first email account to get started.'}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{local:T 'Add account'}" Command="{Binding AddAccountCommand}" HorizontalAlignment="Center" Padding="20,8" />
                </StackPanel>

                <!-- Between the list and the reading pane just a divider line, dragged to resize: a few pixels either side of
                     a one-pixel row. -->
                <GridSplitter x:Name="RowSplitter" Grid.Row="2" Height="7" Margin="0,-3" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Focusable="False" Panel.ZIndex="2">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource DividerBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <!-- The same, standing up: reading pane on the right -->
                <GridSplitter x:Name="ColumnSplitter" Grid.Column="1" Grid.RowSpan="4" Width="7" Margin="-3,0" VerticalAlignment="Stretch" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Focusable="False" Panel.ZIndex="2" Visibility="Collapsed">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource DividerBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Reading pane (shared with the message window); with Fill screen it covers the list, under a Back bar -->
                <DockPanel x:Name="ReadingHost" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Panel.ZIndex="3">
                    <Border x:Name="BackBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Button Style="{StaticResource ToolbarButton}" Tag="&#xE72B;" Content="{local:T 'Back to the list'}" HorizontalAlignment="Left"
                                Command="{Binding CloseReadingCommand}" ToolTip="{local:T 'Back to the list (Esc)'}" />
                    </Border>
                    <local:ReadingView x:Name="Reading" DataContext="{Binding Reader}" Tag="{Binding HasItems, ElementName=MessageList}" />
                </DockPanel>
            </Grid>
        </Grid>
        <!-- ═══ Calendar module (replaces the mail toolbar and area while shown) ═══ -->
        <Grid x:Name="CalendarHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <Grid x:Name="ContactsHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <Grid x:Name="TasksHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
