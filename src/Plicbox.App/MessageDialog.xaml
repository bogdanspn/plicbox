<Window x:Class="Plicbox.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource TextBrush}">
    <!-- Margin leaves room for the shadow, which needs a transparent window around the card. -->
    <Border Margin="16" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource StrongDividerBrush}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.22" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" LineHeight="20" />
                <CheckBox x:Name="Option" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="OptionText" TextWrapping="Wrap" />
                        <TextBlock x:Name="OptionNote" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" IsCancel="True" MinWidth="90" Padding="16,7" Margin="0,0,10,0" Content="{local:T 'Cancel'}"
                        Visibility="Collapsed" />
                <Button x:Name="SecondaryButton" IsCancel="True" MinWidth="110" Padding="16,7" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Padding="16,7"
                        Margin="10,0,0,0" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
