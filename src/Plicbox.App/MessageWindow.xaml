<Window x:Class="Plicbox.App.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Width="1000" Height="780" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE97A;" Content="{local:T 'Reply'}" Click="Reply_Click" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE8C2;" Content="{local:T 'Reply All'}" Click="ReplyAll_Click" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xEE35;" Content="{local:T 'Forward'}" Click="Forward_Click" />
                <Button x:Name="FlagButton" Style="{StaticResource ToolbarButton}" Tag="&#xE7C1;" Content="{local:T 'Flag'}" Click="Flag_Click" Margin="12,0,0,0" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete'}" Click="Delete_Click" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE749;" Content="{local:T 'Print'}" Click="Print_Click" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- The same view as the main window's reading pane: chips, people menus, notices, attachments, message menu -->
        <local:ReadingView x:Name="Reading" Grid.Row="1" />
    </Grid>
</Window>
