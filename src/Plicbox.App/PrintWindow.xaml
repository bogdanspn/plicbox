<Window x:Class="Plicbox.App.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1080" Height="860" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- −/+ next to the number of copies -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Print / Cancel on top, as in the other settings-style windows -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" Click="Print_Click" Padding="14,7" IsDefault="True" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PrintIcon" Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,8,0" FontWeight="Normal" />
                            <TextBlock x:Name="PrintText" Text="{local:T 'Print'}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{local:T 'Cancel'}" IsCancel="True" Margin="10,0,0,0" Padding="14,6" />
                </StackPanel>
                <TextBlock x:Name="SheetsText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BusySpinner" Style="{StaticResource Spinner}" Margin="0,0,8,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Border DockPanel.Dock="Left" Width="280" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,4,20,20">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Printer'}" />
                    <ComboBox x:Name="PrinterBox" DisplayMemberPath="Label" SelectionChanged="Printer_Changed" />

                    <StackPanel x:Name="CopiesPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Copies'}" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource StepButton}" Content="&#xE738;" Click="FewerCopies_Click" ToolTip="{local:T 'Fewer'}" />
                            <TextBox x:Name="CopiesBox" Grid.Column="1" Text="1" TextAlignment="Center" Margin="6,0" VerticalContentAlignment="Center"
                                     PreviewTextInput="Copies_PreviewTextInput" TextChanged="Copies_TextChanged" />
                            <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="&#xE710;" Click="MoreCopies_Click" ToolTip="{local:T 'More'}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Pages'}" />
                    <ComboBox x:Name="PagesBox" DisplayMemberPath="Label" SelectionChanged="Pages_Changed" />
                    <TextBox x:Name="PageRangeBox" Margin="0,8,0,0" Visibility="Collapsed" local:Placeholder.Text="{local:T 'e.g. 1-3, 5'}"
                             TextChanged="PageRange_Changed" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Layout'}" />
                    <ComboBox x:Name="LayoutBox" DisplayMemberPath="Label" SelectionChanged="Layout_Changed" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Paper size'}" />
                    <ComboBox x:Name="PaperBox" DisplayMemberPath="Label" SelectionChanged="Paper_Changed" />

                    <StackPanel x:Name="ColorPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Color'}" />
                        <ComboBox x:Name="ColorBox" DisplayMemberPath="Label" SelectionChanged="Color_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="DuplexPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T 'Two-sided'}" />
                        <ComboBox x:Name="DuplexBox" DisplayMemberPath="Label" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Preview: the pages as they will come out of the printer -->
        <Grid Background="{DynamicResource ReadingBackdropBrush}">
            <!-- Lays the message out for paper; never shown (the pages below are what it makes). -->
            <wv2:WebView2 x:Name="Browser" Visibility="Hidden" Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <ItemsControl x:Name="Pages" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.VirtualizationMode="Standard" Focusable="False">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PreviewScroll" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Focusable="False" Padding="0,28,0,12">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PrintPreviewPage}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="Black" />
                                </Border.Effect>
                                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Loaded="PageImage_Loaded" Unloaded="PageImage_Unloaded" />
                            </Border>
                            <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="PreparingPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Spinner}" Margin="0,0,10,0" />
                <TextBlock Text="{local:T 'Preparing preview…'}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
