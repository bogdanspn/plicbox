<Window x:Class="Plicbox.App.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- A value you can select and copy, that looks like plain text (no box, no focus line). -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Margin leaves room for the shadow, which needs a transparent window around the card (as in MessageDialog). -->
    <Border Margin="16" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource StrongDividerBrush}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.22" />
        </Border.Effect>
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="KindText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,10" />
            <Grid x:Name="Fields">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
            <Button IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Padding="16,7"
                    HorizontalAlignment="Right" Margin="0,20,0,0" Content="{local:T 'OK'}" Click="Ok_Click" />
        </StackPanel>
    </Border>
</Window>
