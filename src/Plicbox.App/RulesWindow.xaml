<Window x:Class="Plicbox.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plicbox.App.ViewModels"
        xmlns:core="clr-namespace:Plicbox.Core;assembly=Plicbox.Core"
        xmlns:local="clr-namespace:Plicbox.App"
        Title="{local:T 'Rules'}" Width="1060" Height="760" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="AddLink" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-8,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndCloseCommand}" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <TextBlock Text="{local:T 'Save &amp; Close'}" />
                    </StackPanel>
                </Button>
                <Button Content="{local:T 'Cancel'}" IsCancel="True" Margin="10,0,0,0" Padding="14,6" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE710;" Content="{local:T 'New rule'}" Command="{Binding NewRuleCommand}" Margin="14,0,0,0" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete'}" Command="{Binding DeleteRuleCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE70E;" Command="{Binding MoveUpCommand}" ToolTip="{local:T 'Run earlier'}" Margin="10,0,0,0" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE70D;" Command="{Binding MoveDownCommand}" ToolTip="{local:T 'Run later'}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource DangerTextBrush}" Margin="18,8,18,0" TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Rules, in the order they run -->
            <Grid Background="{DynamicResource ChromeBrush}">
                <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource PaneListItem}" Padding="0,8" BorderThickness="0,0,1,0"
                         BorderBrush="{DynamicResource DividerBrush}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RuleEditor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" VerticalAlignment="Top" Margin="0,1,0,0" ToolTip="{local:T 'On / off'}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="RuleName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5"
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="RuleName" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel VerticalAlignment="Center" Margin="28,0" Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="30" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T 'No rules yet'}" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
                               Text="{local:T 'Click New rule, or right-click any message and choose Create Rule to start from it.'}" />
                </StackPanel>
            </Grid>

            <!-- The selected rule, as a sentence -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <StackPanel Style="{StaticResource PagePanel}" Margin="24,18,24,24">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="10,6" />

                    <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'When'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="{local:T 'A message arrives in'}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding DataContext.AccountChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding AccountChoice}" DisplayMemberPath="Label" MinWidth="240" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,8,0,0">
                        <StackPanel.Resources>
                            <!-- Grey and informative normally; red with a warning sign when the account and folder don't fit together. -->
                            <Style x:Key="ScopeColour" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScopeIsProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ScopeColour}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScopeIsProblem}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource ScopeColour}" Text="{Binding ScopeNote}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="640" />
                    </StackPanel>

                    <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'If'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,6">
                        <ComboBox ItemsSource="{x:Static vm:RulesViewModel.MatchChoices}" SelectedItem="{Binding MatchChoice}" DisplayMemberPath="Label" MinWidth="80" />
                        <TextBlock Text="{local:T 'of these are true:'}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Conditions}" Margin="10,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionEditor}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Static vm:ConditionEditor.Fields}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Field}" />
                                    <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Operators}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Operator}">
                                        <!-- Yes/no tests ("are on a phishing or malware list") have no values: the wording gets their room. -->
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasValues}" Value="False">
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Setter Property="MinWidth" Value="152" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <Grid Grid.Column="2" Margin="8,0,0,0" Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox x:Name="Values" Text="{Binding ValuesText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{local:T 'Several? Separate them with commas: any of them matches.'}" />
                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource HintBrush}" FontStyle="Italic" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=Values}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="8,6" Margin="4,0,0,0" ToolTip="{local:T 'Remove'}"
                                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource AddLink}" Tag="&#xE710;" Content="{local:T 'Add condition'}" Margin="2,4,0,0"
                            Command="{Binding DataContext.AddConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Then'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="10,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActionEditor}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Static vm:ActionEditor.Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Kind}" />
                                    <Button x:Name="FolderButton" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Left" Padding="12,6" MinWidth="220"
                                            HorizontalContentAlignment="Left"
                                            Visibility="{Binding NeedsFolder, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ChooseFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                            <TextBlock x:Name="FolderText" Text="{Binding FolderLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="8,6" Margin="4,0,0,0" ToolTip="{local:T 'Remove'}"
                                            Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding FolderLabel}" Value="{x:Null}">
                                        <Setter TargetName="FolderText" Property="Text" Value="{local:T 'Choose a folder…'}" />
                                        <Setter TargetName="FolderText" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource AddLink}" Tag="&#xE710;" Content="{local:T 'Add action'}" Margin="2,4,0,0"
                            Command="{Binding DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <CheckBox Content="{local:T 'Stop here: don\'t run later rules on these messages'}" IsChecked="{Binding StopAfter}" Margin="10,10,0,0" />

                    <!-- What it would catch right now -->
                    <Border Style="{StaticResource SectionHeader}"><TextBlock Text="{local:T 'Preview'}" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
                    <DockPanel Margin="10,0,0,0">
                        <Button DockPanel.Dock="Right" Content="{local:T 'Apply to these now'}" Padding="12,5" VerticalAlignment="Center"
                                Visibility="{Binding CanApplyNow, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.ApplyNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Text="{Binding PreviewText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PreviewMessages}" Margin="10,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:MessageSummary}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Sender" Text="{Binding FromName}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding FromName}" Value="">
                                        <Setter TargetName="Sender" Property="Text" Value="{Binding FromAddress}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
