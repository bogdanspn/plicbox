<Window x:Class="Plicbox.App.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
        Title="{Binding Heading}" Width="640" SizeToContent="Height" MinWidth="520" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" FontSize="14" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="RowGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="DueChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Command" Value="{Binding SetDueCommand}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Save & Close · Cancel · which list, as in the other editors -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Save_Click" ToolTip="{local:T 'Save &amp; Close (Ctrl+S)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <TextBlock Text="{local:T 'Save &amp; Close'}" />
                    </StackPanel>
                </Button>
                <Button Content="{local:T 'Cancel'}" Margin="10,0,0,0" Padding="14,6" Click="Cancel_Click" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="18,0,8,0" />
                <ComboBox MinWidth="220" ItemsSource="{Binding Lists}" SelectedItem="{Binding List}" DisplayMemberPath="Label" ToolTip="{local:T 'Which list it goes in'}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="32,18,32,28">
            <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- What -->
            <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="10,7"
                     local:Placeholder.Text="{local:T 'What needs doing? Try “Send the report friday”'}" />
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0" Visibility="{Binding TitleHint, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="12" Foreground="{DynamicResource LinkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TitleHint}" FontSize="12.5" Foreground="{DynamicResource LinkBrush}" />
            </StackPanel>

            <!-- When -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE787;" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <DatePicker Width="160" SelectedDate="{Binding Due}" />
                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Today'}" CommandParameter="today" Margin="10,0,0,0" />
                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Tomorrow'}" CommandParameter="tomorrow" />
                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Next week'}" CommandParameter="nextweek" />
                    <Button Style="{StaticResource DueChip}" Content="{local:T 'No date'}" CommandParameter="none"
                            Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </Grid>
            <TextBlock Text="{Binding DueSummary}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" Margin="30,6,0,0" />

            <!-- Notes -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE70B;" VerticalAlignment="Top" Margin="0,8,0,0" />
                <TextBox Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="110" MaxHeight="320" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,7"
                         local:Placeholder.Text="{local:T 'Notes'}" />
            </Grid>

            <!-- The email it came from -->
            <Border Margin="30,16,0,0" Padding="12,9" CornerRadius="6" Background="{DynamicResource InfoFillBrush}" BorderBrush="{DynamicResource InfoStrokeBrush}" BorderThickness="1"
                    Visibility="{Binding HasEmail, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{local:T 'Open'}" Tag="&#xE8A7;" Padding="8,3" Command="{Binding OpenEmailCommand}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" Foreground="{DynamicResource LinkBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EmailText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
