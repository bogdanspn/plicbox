<UserControl x:Class="Plicbox.App.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plicbox.App.ViewModels"
             xmlns:local="clr-namespace:Plicbox.App"
             FontFamily="{DynamicResource UiFont}" FontSize="14">
    <UserControl.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!-- The round tick: an empty ring, a faint tick on hover, filled when done (its row's or editor's IsCompleted). -->
        <Style x:Key="RoundCheck" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="#8A8F98" StrokeThickness="1.5" Fill="Transparent" />
                            <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="#8A8F98"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LinkBrush}" />
                                <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource LinkBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LinkBrush}" />
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                <Setter TargetName="Tick" Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title struck through and greyed once done. -->
        <Style x:Key="TaskTitle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,1,4,0" />
        </Style>

        <!-- A section: a thin line above its heading, no box around it (keeps the page open). -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,16,0,6" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <Style x:Key="CardSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="DueChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="0,8,6,0" />
            <Setter Property="Command" Value="{Binding SetDueCommand}" />
        </Style>

        <!-- A task: lined up with the quick-add field above (same edges, same rounding), without the dotted focus line -->
        <Style x:Key="TaskItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="12,0,12,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,9,12,9" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AltRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTaskCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource ToolbarLineBrush}" BorderThickness="0,0,0,1" />

        <!-- ═══ Toolbar ═══ -->
        <DockPanel Margin="12,0,16,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Height="{StaticResource ToolbarItemHeight}">
                <Button x:Name="NewButton" Style="{StaticResource AccentButton}" Tag="&#xE710;" Content="{local:T 'New'}" Padding="12,6" Click="NewButton_Click"
                        ToolTip="{local:T 'New task (Ctrl+N)'}" />
                <Button Style="{StaticResource RefreshButton}" Content="{local:T 'Refresh'}" Command="{Binding RefreshCommand}" Margin="10,0,0,0"
                        local:Spin.IsSpinning="{Binding IsBusy}" ToolTip="{Binding RefreshToolTip}" />
            </StackPanel>
            <local:ToolbarSearch x:Name="TaskSearch" DockPanel.Dock="Right" HorizontalAlignment="Right" Placeholder="{local:T 'Search tasks'}" Text="{Binding SearchText}"
                                   Margin="6,0,0,0" />
            <!-- What you do most with the selected task -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="{StaticResource ToolbarItemHeight}" IsEnabled="{Binding HasSelection}">
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE930;" Content="{Binding DoneLabel}" Command="{Binding ToggleSelectedCommand}" ToolTip="{local:T 'Mark as done (Space)'}" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DueButton" Style="{StaticResource ToolbarButton}" Tag="&#xE787;" Content="{local:T 'Due'}" Click="Due_Click" ToolTip="{local:T 'Set the due date'}" />
                    <Button Style="{StaticResource DropButton}" Click="Due_Click" ToolTip="{local:T 'Set the due date'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MoveButton" Style="{StaticResource ToolbarButton}" Tag="&#xE8DE;" Content="{local:T 'Move'}" Click="Move_Click" ToolTip="{local:T 'Move to another list'}" />
                    <Button Style="{StaticResource DropButton}" Click="Move_Click" ToolTip="{local:T 'Move to another list'}" />
                </StackPanel>
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE715;" Content="{local:T 'Open Email'}" Command="{Binding OpenSelectedEmailCommand}"
                        IsEnabled="{Binding SelectedHasEmail}" ToolTip="{local:T 'Open the email it was made from'}" />
                <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete'}" Command="{Binding DeleteCommand}" ToolTip="{local:T 'Delete (Del)'}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="56" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition MinWidth="340" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition x:Name="DetailColumn" Width="420" MaxWidth="700" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar: smart lists, then your lists ═══ -->
            <!-- Dragged narrow, the sidebar folds into a strip of icons (MainWindow.SyncSidebarWidths) -->
            <local:SidebarRail x:Name="Rail" Visibility="Collapsed" ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" />
            <Grid x:Name="SidebarPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Height="8" />
                <Border Grid.Row="1" Margin="12,0,12,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource WarningFillBrush}" BorderBrush="{DynamicResource WarningStrokeBrush}" BorderThickness="1"
                        Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="13" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BannerAction}" Command="{Binding FixBannerCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="ListsBox" Grid.Row="2" ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0" local:Gutter.ScrollBarWidth="8"
                         ContextMenuOpening="Lists_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Header" Orientation="Horizontal" Margin="16,14,18,4">
                                        <TextBlock x:Name="HeaderIcon" Style="{StaticResource Icon}" Text="&#xE77B;" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Lists">
                                            <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TaskListEntry}">
                            <!-- Lists under a heading (an account's) are set in as far as Mail's folders under theirs; the smart lists aren't. -->
                            <Grid x:Name="Row" Height="33" Margin="34,0,18,0" ToolTip="{Binding Hint}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" VerticalAlignment="Center" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Group}" Value="">
                                    <Setter TargetName="Row" Property="Margin" Value="16,0,18,0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" Style="{StaticResource ToolbarButton}" Tag="&#xE710;" Content="{local:T 'New list'}" HorizontalAlignment="Left" Margin="12,4,0,8"
                        Foreground="{DynamicResource LinkBrush}" Command="{Binding NewListCommand}" />
                <Border Grid.Row="4" Height="49" />
            </Grid>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource SidebarSplitter}" />
            <!-- Module tabs: shared out evenly across the sidebar and its splitter, up to the white area (as in eM Client) -->
            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Panel.ZIndex="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <UniformGrid x:Name="ModuleTabs" Rows="1">
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE715;" ToolTip="{local:T 'Mail (Ctrl+1)'}" GroupName="TasksModule" Click="MailModule_Click" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE787;" ToolTip="{local:T 'Calendar (Ctrl+2)'}" GroupName="TasksModule" Click="CalendarModule_Click" />
                    <RadioButton Style="{StaticResource ModuleButton}" Content="&#xE77B;" ToolTip="{local:T 'Contacts (Ctrl+3)'}" GroupName="TasksModule" Click="ContactsModule_Click" />
                    <RadioButton x:Name="TasksModuleButton" Style="{StaticResource ModuleButton}" Content="&#xE930;" ToolTip="{local:T 'Tasks (Ctrl+4)'}" GroupName="TasksModule" IsChecked="True" />
                    <!-- Folds the sidebar into a strip of icons (‹), and opens it again from there (›) -->
                    <Button x:Name="FoldButton" Style="{StaticResource ModuleFoldButton}" Content="&#xE76B;" ToolTip="{local:T 'Collapse sidebar'}" />
                </UniformGrid>
            </Border>

            <!-- ═══ The tasks ═══ -->
<!-- A divider line along its edge, as between the other panes -->
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource DividerBrush}" />
            <Grid Grid.Column="2" Margin="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,12,16,8">
                    <TextBlock Text="{Binding ListTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ListHint}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Quick add: type and press Enter; dates in the words are understood -->
                <StackPanel Grid.Row="1" Margin="12,0,12,8" Visibility="{Binding CanAddHere, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBox x:Name="QuickBox" Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7"
                                 local:Placeholder.Text="{Binding QuickPlaceholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddQuickCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Foreground="{DynamicResource LinkBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,0" Visibility="{Binding QuickHint, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="11" Foreground="{DynamicResource LinkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding QuickHint}" FontSize="12.5" Foreground="{DynamicResource LinkBrush}" />
                        <TextBlock Text="{local:T ' · Enter to add'}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Its scrollbar over the rows' right edge, as the message list's -->
                <ListBox x:Name="TaskList" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0" Padding="0" Background="Transparent"
                         AlternationCount="2" ItemContainerStyle="{StaticResource TaskItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         KeyDown="TaskList_KeyDown" ContextMenuOpening="TaskList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!-- Heading, then the tasks, with no indent of its own (the theme's group adds one) -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Header" Orientation="Horizontal" Margin="24,12,0,4">
                                        <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding ItemCount}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Overdue">
                                            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TaskRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundCheck}" Margin="0,0,12,0"
                                        ToolTip="{local:T 'Mark as done'}"
                                        Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TaskTitle}" Text="{Binding Title}" FontSize="14.5" />
                                    <WrapPanel Margin="0,2,0,0" Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding DueText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock x:Name="DueIcon" Style="{StaticResource MetaIcon}" Text="&#xE787;" />
                                            <TextBlock x:Name="Due" Style="{StaticResource Meta}" Text="{Binding DueText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding StepsText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Style="{StaticResource MetaIcon}" Text="&#xE73A;" />
                                            <TextBlock Style="{StaticResource Meta}" Text="{Binding StepsText}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetaIcon}" Text="&#xE70B;" Margin="0,1,12,0" ToolTip="{local:T 'Has notes'}"
                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding HasEmail, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource MetaIcon}" Text="&#xE715;" />
                                            <TextBlock Style="{StaticResource Meta}">
                                                <Hyperlink Style="{StaticResource QuietLink}" ToolTip="{local:T 'Open the email it was made from'}"
                                                           Command="{Binding DataContext.OpenRowEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Run Text="{local:T 'Email'}" /></Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ListName, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Style="{StaticResource MetaIcon}" Text="&#xE8FD;" />
                                            <TextBlock Style="{StaticResource Meta}" Text="{Binding ListName}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                    <Setter TargetName="DueIcon" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                    <Setter TargetName="DueIcon" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <local:EmptyState Grid.Row="2" Title="{Binding EmptyTitle}" Text="{Binding EmptyText}" ActionCommand="{Binding ClearSearchCommand}"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <local:EmptyState.Style>
                        <Style TargetType="local:EmptyState">
                            <Setter Property="Glyph" Value="&#xE73A;" /> <!-- a ticked box -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Glyph" Value="&#xE721;" />
                                    <Setter Property="ActionText" Value="{local:T 'Clear search'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:EmptyState.Style>
                </local:EmptyState>
            </Grid>

            <!-- No gap between the tasks and the open task, just its divider line; the pane is resized by dragging it
                 (a few pixels either side of a column with no width of its own). -->
            <GridSplitter x:Name="DetailSplitter" Grid.Column="3" Style="{StaticResource SidebarSplitter}" Width="6" Margin="-3,0,-3,0" HorizontalAlignment="Stretch" />

            <!-- ═══ The selected task: saves as you type ═══ -->
<!-- A divider line along its edge, as between the other panes -->
            <Border x:Name="DetailLine" Grid.Column="4" Width="1" HorizontalAlignment="Left" Background="{DynamicResource DividerBrush}" />
            <Grid x:Name="DetailPane" Grid.Column="4" Margin="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Margin="18,14,18,20">
                        <!-- Done? · title · close -->
                        <Border Style="{StaticResource Panel}" Margin="0" BorderThickness="0" Padding="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundCheck}" Margin="0,7,10,0" ToolTip="{local:T 'Mark as done'}" Click="EditorCheck_Click" />
                                <TextBox x:Name="EditorTitle" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="17" TextWrapping="Wrap"
                                         AcceptsReturn="False" Padding="8,5" local:Placeholder.Text="{local:T 'Title'}" />
                                <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="7,5" Margin="6,2,0,0" VerticalAlignment="Top" ToolTip="{local:T 'Close'}"
                                        Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                        </Border>

                        <!-- Steps -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSection}" Text="{local:T 'STEPS'}" />
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TaskRow}">
                                            <Grid x:Name="StepRow" Margin="0,2" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource RoundCheck}" Width="18" Height="18" Margin="0,2,10,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ToggleStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource TaskTitle}" Text="{Binding Title}" VerticalAlignment="Center" />
                                                <Button x:Name="RemoveStep" Grid.Column="2" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Padding="5,3" ToolTip="{local:T 'Delete step'}"
                                                        Visibility="Hidden"
                                                        Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="StepRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RemoveStep" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                    <TextBox Text="{Binding NewStep, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5" local:Placeholder.Text="{local:T 'Add a step'}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Foreground="{DynamicResource LinkBrush}" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Due -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSection}" Text="{local:T 'DUE'}" />
                                <DatePicker SelectedDate="{Binding Due}" HorizontalAlignment="Left" Width="180" />
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Today'}" CommandParameter="today" />
                                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Tomorrow'}" CommandParameter="tomorrow" />
                                    <Button Style="{StaticResource DueChip}" Content="{local:T 'Next week'}" CommandParameter="nextweek" />
                                    <Button Style="{StaticResource DueChip}" Content="{local:T 'No date'}" CommandParameter="none"
                                            Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DueSummary}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- List -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSection}" Text="{local:T 'LIST'}" />
                                <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding List}" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSection}" Text="{local:T 'NOTES'}" />
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                         VerticalContentAlignment="Top" Padding="8,6" local:Placeholder.Text="{local:T 'Add notes'}" />
                            </StackPanel>
                        </Border>

                        <!-- The email it came from -->
                        <Border Style="{StaticResource Panel}" Visibility="{Binding HasEmail, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSection}" Text="{local:T 'FROM EMAIL'}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{local:T 'Open'}" Tag="&#xE8A7;" Padding="8,3" Command="{Binding OpenEmailCommand}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" Foreground="{DynamicResource LinkBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EmailText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="{local:T 'Delete task'}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
