<UserControl x:Class="Plicbox.App.ToolbarSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Plicbox.App"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <!-- The small buttons inside the box: their hover tint stays within the field's border. -->
        <Style x:Key="InBoxButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Always open, so nothing on the toolbar moves when you search (Ctrl+F puts the cursor here; Esc or ✕ clears).
         The same size in every module; the "where to search" button is greyed out where there's no choice to make. -->
    <Grid x:Name="Box" Width="264" Height="32">
        <TextBox x:Name="Input" Style="{StaticResource SearchBox}" Padding="0,0,52,0"
                 PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged" />
        <Button x:Name="ClearButton" Style="{StaticResource InBoxButton}" Click="Clear_Click" ToolTip="{local:T 'Clear search (Esc)'}"
                Margin="0,0,32,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
        </Button>
        <!-- Where to search (mail): accent-coloured while the search is narrowed. Three lines narrowing down. -->
        <Button x:Name="OptionsButton" Style="{StaticResource InBoxButton}" Click="Options_Click" ToolTip="{local:T 'Where to search'}"
                Margin="0,0,5,0" IsEnabled="False">
            <Path Data="M2.5,4.5 H13.5 M4.5,8 H11.5 M6.5,11.5 H9.5" Width="16" Height="16" StrokeThickness="1.3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
    </Grid>
</UserControl>
