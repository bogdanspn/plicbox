<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Plicbox.Core\Plicbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
  </ItemGroup>

  <!-- Plicbox's own Google sign-in client, built in when present so new installs skip the one-time setup (gitignored). -->
  <ItemGroup Condition="Exists('google-client.json')">
    <EmbeddedResource Include="google-client.json" LogicalName="google-client.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
